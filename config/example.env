# Example configuration for a self-hosted headless-vote.
# Copy the values you need into wrangler.toml [vars] or your host's environment.
# Do not put secrets in this file or in git.

# Auth adapter: oidc (default) or local
AUTH_PROVIDER=oidc
# Text on the login button. Optional.
AUTH_LABEL=Example IdP

# Required when AUTH_PROVIDER=oidc. Issuer origin only, no path.
OIDC_ISSUER=https://idp.example.com
OIDC_CLIENT_ID=your-public-client-id
OIDC_SCOPES=openid profile email
# OIDC_CLIENT_SECRET is optional and is a secret. Set it outside git.

# Canonical origin of this deployment. Login is refused on other hosts.
APP_ORIGIN=https://vote.example.com

# Email adapter: outbox (stores messages in the database), http, or noop
EMAIL_PROVIDER=outbox
# EMAIL_HTTP_URL=https://mail.example.com/send

# Optional adapter selectors. Defaults are the durable ones.
# RATE_LIMIT_STORE=d1
# WEBHOOK_TRANSPORT=fetch
# ANALYTICS_STORE=d1
# OBJECT_STORE=r2

# Secrets, set with your host's secret store, never committed:
# SESSION_SECRET
# VOTER_KEY_SECRET
