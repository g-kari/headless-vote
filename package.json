{
  "dependencies": {
    "hono": "^4.6.14"
  },
  "description": "Headless voting SaaS: multi-tenant voting API + admin UI (Cloudflare Workers / D1 / R2), admin login via 0g0-id OIDC.",
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.1",
    "@cloudflare/workers-types": "^5.20261110.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.0.0"
  },
  "name": "headless-vote",
  "private": true,
  "scripts": {
    "db:migrate": "wrangler d1 migrations apply headless-vote --remote",
    "db:migrate:local": "wrangler d1 migrations apply headless-vote --local",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "lint": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "type": "module",
  "version": "0.1.0"
}