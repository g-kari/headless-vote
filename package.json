{
  "dependencies": {
    "hono": "^4.6.14"
  },
  "description": "Hyo — headless voting app: multi-tenant voting API and admin UI. Auth, email, storage, rate limits, webhooks, and analytics are swappable adapters.",
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.1",
    "@cloudflare/workers-types": "^5.20261110.0",
    "typescript": "^7.0.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.0.0"
  },
  "name": "headless-vote",
  "private": true,
  "scripts": {
    "db:migrate": "wrangler d1 migrations apply headless-vote --remote",
    "db:migrate:local": "wrangler d1 migrations apply headless-vote --local",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "lint": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test:security:node": "node scripts/security-regressions.mjs && node scripts/visual-explainer-response-security.mjs"
  },
  "type": "module",
  "version": "0.1.0"
}
